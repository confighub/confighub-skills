---
apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app: hello-app
  name: hello-app
  namespace: confighubplaceholder
spec:
  replicas: 1
  template:
    spec:
      containers:
      - image: ghcr.io/acme/hello-app:v0.1.0
        name: hello-app
        ports:
        - containerPort: 8080
        resources: {requests: {cpu: 128m, memory: 128Mi}}            # set-container-resources-defaults
        startupProbe: { httpGet: {path: confighubplaceholder, port: 8080}, ... }   # set-container-probe-defaults
        livenessProbe: { httpGet: {path: confighubplaceholder, port: 8080}, ... } # set-container-probe-defaults
        readinessProbe: { httpGet: {path: confighubplaceholder, port: 8080}, ... } # set-container-probe-defaults
        securityContext:                                              # set-pod-container-security-context-defaults
          allowPrivilegeEscalation: false
          capabilities: { drop: [ALL] }
          privileged: false
          readOnlyRootFilesystem: true
      securityContext:                                                # set-pod-container-security-context-defaults
        fsGroup: 2000
        runAsGroup: 3000
        runAsNonRoot: true
        runAsUser: 1000
        seccompProfile: { type: RuntimeDefault }
---
apiVersion: v1
kind: Service
metadata:
  name: hello-app
  namespace: confighubplaceholder                                     # ensure-namespaces
spec:
  ports:
  - {name: 80-8080, port: 80, protocol: TCP, targetPort: 8080}
  selector: {app: hello-app}
  type: ClusterIP

