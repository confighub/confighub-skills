{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "//": "Rename to settings.local.json. The allow-list covers every Bash() pattern declared in skills' allowed-tools frontmatter, plus commands used in skill code blocks. Enables subagent-based skill evaluations to execute commands without per-call permission prompts.",
  "permissions": {
    "allow": [
      "Bash(cub --help)",
      "Bash(cub * --help)",
      "Bash(CONFIGHUB_AGENT=1 cub --help)",
      "Bash(CONFIGHUB_AGENT=1 cub * --help)",
      "Bash(cub auth status)",
      "Bash(cub * get)",
      "Bash(cub * get *)",
      "Bash(cub * list)",
      "Bash(cub * list *)",
      "Bash(cub * list-* *)",
      "Bash(cub function explain *)",
      "Bash(CONFIGHUB_AGENT=1 cub function explain *)",
      "Bash(cub unit diff *)",
      "Bash(cub unit tree *)",
      "Bash(cub unit bridgestate *)",
      "Bash(cub unit livedata *)",
      "Bash(cub unit livestate *)",
      "Bash(cub unit data *)",
      "Bash(cub unit-action get *)",
      "Bash(cub revision get *)",
      "Bash(cub revision list *)",
      "Bash(cub worker get *)",
      "Bash(cub worker get-envs *)",
      "Bash(cub worker get-secret *)",
      "Bash(cub worker list-function *)",
      "Bash(cub worker logs *)",
      "Bash(cub worker status *)",
      "Bash(cub space create *)",
      "Bash(cub space update *)",
      "Bash(cub unit create *)",
      "Bash(cub unit update *)",
      "Bash(cub unit set-target *)",
      "Bash(cub unit apply *)",
      "Bash(cub unit cancel *)",
      "Bash(cub unit tag *)",
      "Bash(cub unit import *)",
      "Bash(cub unit refresh *)",
      "Bash(cub unit push-upgrade *)",
      "Bash(cub trigger create *)",
      "Bash(cub trigger update *)",
      "Bash(cub filter create *)",
      "Bash(cub filter update *)",
      "Bash(cub target create *)",
      "Bash(cub target update *)",
      "Bash(cub worker create *)",
      "Bash(cub worker update *)",
      "Bash(cub worker install *)",
      "Bash(cub worker upgrade *)",
      "Bash(cub link create *)",
      "Bash(cub link update *)",
      "Bash(cub invocation create *)",
      "Bash(cub changeset create *)",
      "Bash(cub changeset update *)",
      "Bash(cub tag create *)",
      "Bash(cub function do *)",
      "Bash(cub run *)",
      "Bash(cub variant upload *)",
      "Bash(cub variant create *)",
      "Bash(cub variant promote *)",
      "Bash(cub release publish *)",
      "Bash(cub release withdraw *)",
      "Bash(cub helm install *)",
      "Bash(cub helm upgrade *)",
      "Bash(cub helm template *)",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl create *)",
      "Bash(kubectl explain *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl kustomize *)",
      "Bash(kubectl wait *)",
      "Bash(kubectl exec *)",
      "Bash(kubectl rollout *)",
      "Bash(kubectl config *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl -n *)",
      "Bash(helm repo add *)",
      "Bash(helm repo update *)",
      "Bash(helm repo list)",
      "Bash(helm search *)",
      "Bash(argocd app get *)",
      "Bash(argocd app list *)",
      "Bash(argocd app history *)",
      "Bash(argocd app diff *)",
      "Bash(flux get *)",
      "Bash(flux logs *)",
      "Bash(flux stats *)",
      "Bash(kustomize build *)",
      "Bash(yq *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(diff *)",
      "Bash(mkdir -p /tmp/*)",
      "Bash(kind get *)"
    ]
  }
}
