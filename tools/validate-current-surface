  helm_version=$(cub helm version)
  printf '%s\n' "$helm_version" | rg -q 'helm 0\.1\.0 \(commit ce1b62faa92ec045d96b0e938bf289f83501fd17' || fail "installed cub helm add-on differs from profile"
  cub_binary_sha=$(shasum -a 256 "$(command -v cub)" | awk '{print $1}')
  test "$cub_binary_sha" = adc0c6cd53e24d91145eacf40947f929d041613393d4afa36e7d009520133051 || fail "installed cub binary SHA-256 differs from profile"
  cub_build_metadata=$(go version -m "$(command -v cub)")
  printf '%s\n' "$cub_build_metadata" | rg -q 'mod[[:space:]]+github.com/confighub/sdk/cmd/cub[[:space:]]+\(devel\)' || fail "cub module metadata differs from profile"
  printf '%s\n' "$cub_build_metadata" | rg -q 'build[[:space:]]+vcs\.modified=true' || fail "cub modified-build caveat differs from profile"
