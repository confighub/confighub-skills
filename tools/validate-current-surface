#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"

release_mode=false
if test "${1:-}" = "--release"; then
  release_mode=true
  shift
fi
test "$#" -eq 0 || {
  printf '%s\n' 'usage: validate-current-surface [--release]' >&2
  exit 2
}

fail() {
  printf 'static compatibility surface: FAIL: %s\n' "$*" >&2
  exit 1
}

for command_name in jq rg git ruby shasum go; do
  command -v "$command_name" >/dev/null 2>&1 || fail "required command missing: $command_name"
done

expected_skills=$(cat <<'EOF'
app-config
confighub-core
cub-mutate
cub-query
import
incident-management
kubernetes-resources
promote-release
release-publish
rollback-revision
skill-examples-bootstrap
target-bind
triggers-and-applygates
verify-apply
worker-bootstrap
EOF
)

baseline_skills=$(cat <<'EOF'
app-config
confighub-core
cub-apply
cub-mutate
cub-query
import
incident-management
kubernetes-resources
promote-release
rollback-revision
skill-examples-bootstrap
target-bind
triggers-and-applygates
verify-apply
worker-bootstrap
EOF
)

actual_skills=$(find skills -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort)
expected_skill_dirs=$(printf '%s\n%s\n' "$expected_skills" cub-apply | sort)
test "$actual_skills" = "$expected_skill_dirs" || fail "skill IDs differ from the 15 canonical skills plus one compatibility stub"

expected_evals=$(printf '%s\n' "$expected_skills" | sed 's|$|/evals/evals.json|')
actual_evals=$(find skills -path '*/evals/evals.json' -type f | sed 's|^skills/||' | sort)
test "$actual_evals" = "$expected_evals" || fail "eval files differ from the stable 15-file surface"

profile=compatibility/current-profile.v1.json
inventory=compatibility/no-loss-inventory.v1.json
read_capabilities=compatibility/read-capability-subsets.v1.json
authority_cases=compatibility/authority-negative-cases.v1.json
profile_cases=compatibility/exact-profile-behavior-cases.v1.json
semantic_contracts=compatibility/semantic-contracts.v1.json
artifact_manifest=compatibility/release-artifact-manifest.v1.json
render_policy=compatibility/render-source-policy.v1.json
release_review_schema=compatibility/release-review-attestation.schema.json
jq empty .claude-plugin/plugin.json .claude-plugin/marketplace.json hooks/hooks.json \
  .claude/settings.local.json.example "$profile" "$inventory" "$read_capabilities" \
  "$authority_cases" "$profile_cases" "$semantic_contracts" "$artifact_manifest" \
  "$render_policy" "$release_review_schema" || fail "invalid JSON"

jq -e '
  . as $profile |
  .schema_version == "confighub-skills-compatibility/v1" and
  .plugin_version == "0.4.0" and
  .candidate_base_commit == "de74ac357b88e4a39b22b2afb6a6ff232d91ded5" and
  .profile_id == "cub-0.2.11_server-0.2.11_helm-0.1.0" and
  .status == "BLOCK_ACTIVATION_STATIC_ONLY" and
  .authority.raw_bash_autoallow == "BLOCK" and
  .authority.typed_final_argv_wrapper == "NOT_INTEGRATED" and
  .authority.mutation_execution == "BLOCK" and
  .authority.external_approval_broker == "NOT_INTEGRATED" and
  .installed_profile.cub_client.version == "v0.2.11" and
  .installed_profile.cub_client.commit == "683dce12c2f26ad151aa9e5763e60b0ac66172a4" and
  .installed_profile.cub_client.binary_sha256 == "0729618f9a6c22dd646e2ef003cc5103206e9fc2c5abdae1c2b444b1f0534553" and
  .installed_profile.cub_client.build_vcs_modified == true and
  .installed_profile.cub_client.go_module_version == "(devel)" and
  .installed_profile.cub_client.code_signature == "ADHOC_NO_TEAM_IDENTIFIER" and
  .installed_profile.cub_client.package_manager_receipt == "NOT_FOUND" and
  .installed_profile.cub_client.provenance_status == "DIRTY_LOCAL_BUILD_NOT_VERIFIED_OFFICIAL_RELEASE_ASSET" and
  .installed_profile.confighub_server.version == "v0.2.11" and
  .installed_profile.confighub_server.commit == "8cb9f6b4925670658850c8c99357f34fb11a51ad" and
  .installed_profile.cub_helm_addon.version == "0.1.0" and
  .installed_profile.cub_helm_addon.commit == "ce1b62faa92ec045d96b0e938bf289f83501fd17" and
  .surface_counts.skills == 15 and
  .surface_counts.eval_files == 15 and
  .surface_counts.eval_cases == 75 and
  .surface_counts.trigger_families == 38 and
  .surface_counts.capability_dispositions == 68 and
  .surface_counts.eval_dispositions == 78 and
  .current_delivery_contract.release_provider == "OCI" and
  .current_delivery_contract.release_target_field == "Space.ReleaseTargetID" and
  .current_delivery_contract.config_hub_provider_delivery == "VERSIONED_LEGACY_BLOCK" and
  .current_delivery_contract.bridge_or_unit_runtime_delivery == "SUNSET_VERSIONED_LEGACY_BLOCK" and
  any(.known_semantic_gaps[];
    .gap_id == "release-tag-missing-unit-semantics" and
    .status == "BLOCK" and
    .source_checkout_commit == "8cb9f6b4925670658850c8c99357f34fb11a51ad" and
    .exact_installed_server_semantics == "STATICALLY_VERIFIED_ERROR_NOT_LIVE_TESTED") and
  (["mutation-approval-broker", "raw-bash-final-argv-policy",
    "native-approval-expected-head-cas", "approved-unit-state-cas-integration", "release-execution-cas",
    "historical-release-manifest-retention", "historical-release-target-attestation",
    "withdrawal-current-membership-gates", "release-delete-bypasses-withdrawal-gates",
    "worker-log-evidence-boundary", "render-source-execution-boundary"] |
    all(.[]; . as $gap |
      any($profile.known_semantic_gaps[]; .gap_id == $gap and .status == "BLOCK"))) and
  any(.unselected_profiles[]; .profile_id == "cub-0.2.10_server-0.2.11_helm-0.1.0" and .status == "BLOCK_UNSELECTED") and
  any(.known_semantic_gaps[]; .gap_id == "unselected-runtime-profile-0.2.10-0.2.11" and .status == "BLOCK")
' "$profile" >/dev/null || fail "exact compatibility profile changed or overclaims readiness"

jq -e '
  .schema_version == "confighub-skills-read-capabilities/v1" and
  .status == "ASK_PENDING_TYPED_WRAPPER" and
  .raw_bash_autoallow == "BLOCK" and
  .enforcement.current == "NO_PLUGIN_OR_SKILL_BASH_AUTOALLOW" and
  .enforcement.read_execution == "HOST_PERMISSION_ASK" and
  .enforcement.typed_final_argv_wrapper == "NOT_INTEGRATED" and
  (.skills | length) == 15 and
  ([.skills[].skill_id] | length == (unique | length)) and
  all(.skills[]; (.capabilities | type == "array" and length > 0)) and
  ([.denied_from_any_future_autoallow[]] | sort) == ([
    "arbitrary-function-get-or-vet", "controller-hard-refresh",
    "credentials-or-secrets", "file-read-or-write-without-bounded-artifact",
    "mutation", "network-source-or-repository-refresh", "plugin-or-exec-loading",
    "shell-composition-or-expansion", "unknown-verb-or-flag"] | sort)
' "$read_capabilities" >/dev/null || fail "per-skill read capability boundary changed or overclaims enforcement"

jq -e '
  .schema_version == "confighub-skills-render-source-policy/v1" and
  .status == "BLOCK_RENDER_EXECUTION_UNTIL_TYPED_WRAPPER" and
  .source_preflight.outcome_on_pass == "SOURCE_PREFLIGHT_PASS_RENDER_STILL_BLOCKED" and
  .source_preflight.render_allowed == false and
  .source_preflight.duplicate_yaml_keys == "DENY" and
  .source_preflight.remote_url_or_repository == "DENY" and
  .source_preflight.unpinned_source_or_dependency == "DENY" and
  .source_preflight.plugin_or_exec_generator == "DENY" and
  .source_preflight.helm_tpl_dynamic_evaluation == "DENY" and
  .source_preflight.helm_dependency_archives == "DENY_REQUIRE_UNPACKED_VENDORED_DIRECTORY" and
  (.source_preflight.kustomize_schema_authority | contains("api@v0.21.1")) and
  ([.source_preflight.kustomize_file_fields_traversed[]] | sort) == ([
    "openapi.path","resources[]","bases[]","components[]","crds[]","configurations[]",
    "patches[].path","patchesJson6902[].path","replacements[].path",
    "configMapGenerator[].files[]","configMapGenerator[].envs[]","configMapGenerator[].env"] | sort) and
  .future_wrapper_requirements.network == "OFF" and
  .future_wrapper_requirements.renderer_binary_digest_required == true and
  .future_wrapper_requirements.max_source_bytes > 0 and
  .future_wrapper_requirements.max_rendered_bytes > 0 and
  .future_wrapper_requirements.max_resources > 0 and
  .future_wrapper_requirements.receipt_required == true and
  (.claim_boundary | contains("not evidence"))
' "$render_policy" >/dev/null || fail "render source policy is incomplete or falsely claims enforcement"

jq -e '
  .current_boundary == "NO_RAW_BASH_AUTOALLOW_HOST_ASK" and
  .typed_wrapper == "NOT_INTEGRATED" and
  (.cases | length) == 12 and
  ([.cases[].case_id] | length == (unique | length)) and
  all(.cases[]; .current_outcome == "NOT_AUTOALLOWED" or .current_outcome == "HOST_ASK") and
  all(.cases[] | select(.category != "legitimate-read-regression"); .future_typed_outcome == "DENY") and
  any(.cases[]; .case_id == "quoted-where-comparison" and .current_outcome == "HOST_ASK")
' "$authority_cases" >/dev/null || fail "raw Bash negative/adversarial case matrix is incomplete"

jq -e '
  .profile_id == "cub-0.2.11_server-0.2.11_helm-0.1.0" and
  .reviewed_client_commit == "683dce12c2f26ad151aa9e5763e60b0ac66172a4" and
  .reviewed_server_commit == "8cb9f6b4925670658850c8c99357f34fb11a51ad" and
  (.cases | length) == 17 and
  ([.cases[].case_id] | length == (unique | length)) and
  . as $matrix |
  (["approval-numeric-selector-rejected", "approval-tag-selector-rejected",
    "approval-changeset-selector-rejected", "approval-head-race-no-expected-cas",
    "unit-update-cas-primitive-not-integrated",
    "publish-no-expected-manifest-or-target-cas", "historical-same-count-member-swap",
    "historical-deleted-revision", "withdrawal-current-membership-drift",
    "release-delete-retention", "historical-target-hidden-public-manifest",
    "release-delete-bypasses-withdrawal-gates", "worker-run-positional-slug",
    "worker-run-auto-creates-missing-worker", "worker-logs-unbound-full-file-scan",
    "tag-mapping-mutable-at-publish",
    "untagged-publish-auto-tag-side-effect"] |
    all(.[]; . as $case | any($matrix.cases[]; .case_id == $case))) and
  any(.cases[]; .case_id == "approval-numeric-selector-rejected" and .expected == "BLOCK_NON_HEAD_SELECTOR") and
  any(.cases[]; .case_id == "approval-tag-selector-rejected" and .expected == "BLOCK_NON_HEAD_SELECTOR") and
  any(.cases[]; .case_id == "approval-changeset-selector-rejected" and .expected == "BLOCK_NON_HEAD_SELECTOR") and
  any(.cases[]; .case_id == "approval-head-race-no-expected-cas" and .expected == "APPROVAL_HEAD_RACE_BLOCK") and
  any(.cases[]; .case_id == "unit-update-cas-primitive-not-integrated" and .expected == "APPROVED_STATE_CAS_NOT_INTEGRATED") and
  any(.cases[]; .case_id == "publish-no-expected-manifest-or-target-cas" and .expected == "RELEASE_EXECUTION_CAS_BLOCK") and
  any(.cases[]; .case_id == "historical-same-count-member-swap" and .expected == "REQUIRE_RECEIPT_AND_REVISION_RELEASES") and
  any(.cases[]; .case_id == "historical-deleted-revision" and .expected == "HISTORICAL_RELEASE_MANIFEST_UNPROVEN") and
  any(.cases[]; .case_id == "withdrawal-current-membership-drift" and .expected == "WITHDRAWAL_MEMBERSHIP_DRIFT_BLOCK") and
  any(.cases[]; .case_id == "release-delete-retention" and .expected == "REQUIRE_RETAINED_RECEIPT_BEFORE_DELETE") and
  any(.cases[]; .case_id == "historical-target-hidden-public-manifest" and .expected == "REQUIRE_TRUSTED_MANIFEST_TARGET_ATTESTATION") and
  any(.cases[]; .case_id == "release-delete-bypasses-withdrawal-gates" and .expected == "RELEASE_DELETE_WITHOUT_WITHDRAW_OR_GATE_BLOCK") and
  any(.cases[]; .case_id == "worker-run-positional-slug" and .expected == "REQUIRE_EXACTLY_ONE_WORKER_SLUG") and
  any(.cases[]; .case_id == "worker-run-auto-creates-missing-worker" and .expected == "CLASSIFY_WORKER_RUN_AS_MUTATING") and
  any(.cases[]; .case_id == "worker-logs-unbound-full-file-scan" and .expected == "WORKER_LOG_EVIDENCE_BLOCK") and
  any(.cases[]; .case_id == "tag-mapping-mutable-at-publish" and .expected == "RELEASE_TAG_MAPPING_CAS_BLOCK") and
  any(.cases[]; .case_id == "untagged-publish-auto-tag-side-effect" and .expected == "BIND_AUTO_TAG_SIDE_EFFECT")
' "$profile_cases" >/dev/null || fail "exact-profile behavior case matrix is incomplete"

jq -e '.version == "0.4.0"' .claude-plugin/plugin.json >/dev/null || fail "plugin version is not 0.4.0"
jq -e '.description | contains("Evaluation-only") and contains("activation is BLOCK")' .claude-plugin/plugin.json >/dev/null || fail "plugin listing overclaims activation readiness"
jq -e '.metadata.description | contains("Evaluation-only") and contains("authoritative command execution remains BLOCK")' .claude-plugin/marketplace.json >/dev/null || fail "marketplace listing overclaims activation readiness"
jq -e '.["//"] | contains("Reference-only") and contains("do not rename or use it to activate")' .claude/settings.local.json.example >/dev/null || fail "settings example is presented as activation guidance"
jq -e '
  .candidate_plugin_version == "0.4.0" and
  .candidate_base_commit == "de74ac357b88e4a39b22b2afb6a6ff232d91ded5" and
  .compatibility_profile == "compatibility/current-profile.v1.json" and
  any(.global_authority_blocks[];
    .block_id == "approved-unit-state-cas-integration" and .status == "BLOCK" and
    .result == "APPROVED_STATE_CAS_NOT_INTEGRATED" and
    ([.applies_to[]] | sort) == (["function-or-run-mutation","unit-patch","unit-restore","unit-update","variant-promotion"] | sort)) and
  any(.retired_skill_dispositions[];
    .skill_id == "cub-apply" and .disposition == "REPLACED_BY" and .replacement == "release-publish") and
  any(.compatibility_aliases[];
    .alias == "/confighub-skills:cub-apply" and .disposition == "REPLACED_BY" and
    .replacement == "release-publish" and .observable_path == "commands/cub-apply.md") and
  any(.compatibility_aliases[];
    .alias == "cub-apply" and .kind == "skill-identity-stub" and .disposition == "REPLACED_BY" and
    .replacement == "release-publish" and .observable_path == "skills/cub-apply/SKILL.md") and
  any(.upstream_change_dispositions[];
    .change_id == "de74ac3-release-publish-addition" and .disposition == "PRESERVED") and
  any(.upstream_change_dispositions[];
    .change_id == "de74ac3-verify-apply-deletion" and .disposition == "PRESERVED")
' \
  "$inventory" >/dev/null || fail "inventory/profile version mismatch"

git merge-base --is-ancestor de74ac357b88e4a39b22b2afb6a6ff232d91ded5 HEAD || fail "candidate branch is not based on upstream de74ac3"

inventory_skills=$(jq -r '.skills[].skill_id' "$inventory" | sort)
test "$inventory_skills" = "$expected_skills" || fail "typed inventory does not cover exactly the stable skill IDs"

jq -e '
  (.skills | length) == 15 and
  ([.skills[].trigger_dispositions[]] | length) == 38 and
  ([.skills[].capability_dispositions[]] | length) == 68 and
  ([.skills[].eval_dispositions[]] | length) == 78 and
  all(.skills[];
    (.trigger_dispositions | type == "array" and length > 0) and
    (.capability_dispositions | type == "array" and length > 0) and
    (.eval_dispositions | type == "array" and length > 0) and
    ([.trigger_dispositions[].trigger_id] | length == (unique | length)) and
    ([.capability_dispositions[].capability_id] | length == (unique | length)) and
    ([.eval_dispositions[].eval_id] | length == (unique | length))
  ) and
  (.disposition_enum | type == "array" and length == 7 and index("BLOCKED_PENDING_EVIDENCE_PROXY") != null) and
  (.disposition_enum as $allowed |
    ([.global_legacy_jobs[].disposition,
      .deleted_surface_dispositions[].disposition,
      .retired_skill_dispositions[].disposition,
      .compatibility_aliases[].disposition,
      .upstream_change_dispositions[].disposition,
      .skills[].skill_disposition,
      .skills[].trigger_dispositions[].disposition,
      .skills[].capability_dispositions[].disposition,
      .skills[].eval_dispositions[].disposition] as $values |
      all($values[]; . as $d | ($allowed | index($d)) != null))) and
  ([.. | objects | select(.disposition? == "REPLACED_BY")] |
    all(.[]; (((.replacement? // .current_eval? // "") | type) == "string") and
      ((.replacement? // .current_eval? // "") | length) > 0))
' "$inventory" >/dev/null || fail "inventory dispositions are incomplete or outside the typed enum"

test -f commands/cub-apply.md || fail "deprecated cub-apply compatibility command disappeared"
command_frontmatter=$(./tools/parse-frontmatter commands/cub-apply.md) || fail "deprecated cub-apply command frontmatter is invalid"
printf '%s' "$command_frontmatter" | jq -e '.["allowed-tools"] == []' >/dev/null || fail "deprecated cub-apply command grants tools"
rg -q 'release-publish' commands/cub-apply.md || fail "deprecated cub-apply alias does not route to release-publish"
stub_frontmatter=$(./tools/parse-frontmatter skills/cub-apply/SKILL.md) || fail "cub-apply Skill stub frontmatter is invalid"
printf '%s' "$stub_frontmatter" | jq -e '.name == "cub-apply" and .["allowed-tools"] == [] and .["read-capability-subset"] == "none" and .["compatibility-stub"] == true' >/dev/null || fail "cub-apply Skill stub is not a no-tools compatibility identity"
rg -q 'release-publish' skills/cub-apply/SKILL.md || fail "cub-apply Skill stub does not route to release-publish"

tmp_dir=$(mktemp -d)
trap 'rm -rf "$tmp_dir"' EXIT

: >"$tmp_dir/current-evals"
while IFS= read -r skill; do
  skill_file="skills/$skill/SKILL.md"
  eval_file="skills/$skill/evals/evals.json"
  test -f "$skill_file" || fail "missing $skill_file"
  rg -q '^\*\*Authority boundary:\*\*' "$skill_file" || fail "missing authority boundary in $skill"

  frontmatter=$(./tools/parse-frontmatter "$skill_file") || fail "full YAML frontmatter parse failed for $skill"
  printf '%s' "$frontmatter" | jq -e --arg skill "$skill" '
    .name == $skill and
    (.description | type == "string" and length > 0) and
    (.phase | type == "string" and length > 0) and
    .["allowed-tools"] == [] and
    .["read-capability-subset"] == $skill and
    (has("compatibility-stub") | not)
  ' >/dev/null || fail "frontmatter policy mismatch for $skill"
  description=$(printf '%s' "$frontmatter" | jq -r '.description')
  test "${#description}" -le 340 || fail "skill-listing description exceeds 340 characters in $skill"

  jq -e --arg skill "$skill" '
    any(.skills[]; .skill_id == $skill and (.capabilities | length > 0))
  ' "$read_capabilities" >/dev/null || fail "machine-readable read subset missing for $skill"

  jq -e '
    .execution_policy == "PROPOSE_ONLY_UNTIL_EXTERNAL_BROKER" and
    ((.evals // .prompts) | type == "array" and length > 0) and
    all((.evals // .prompts)[];
      (.name | type == "string" and length > 0) and
      (.prompt | type == "string" and length > 0) and
      (.expected_output | type == "string" and length > 0)) and
    ([((.evals // .prompts)[].name)] | length == (unique | length))
  ' "$eval_file" >/dev/null || fail "eval policy/schema/expectation failure in $skill"
  jq -r '(.evals // .prompts)[].name' "$eval_file" >>"$tmp_dir/current-evals"
done <<<"$expected_skills"

sort -u "$tmp_dir/current-evals" -o "$tmp_dir/current-evals"
test "$(wc -l <"$tmp_dir/current-evals" | tr -d ' ')" = "75" || fail "current eval-case count is not 75"

: >"$tmp_dir/current-evals-qualified"
while IFS= read -r skill; do
  jq -r --arg skill "$skill" '(.evals // .prompts)[] | [$skill,.name] | @tsv' \
    "skills/$skill/evals/evals.json" >>"$tmp_dir/current-evals-qualified"
done <<<"$expected_skills"
LC_ALL=C sort -u "$tmp_dir/current-evals-qualified" -o "$tmp_dir/current-evals-qualified"
jq -r '.skills[] as $skill | $skill.eval_dispositions[] | [$skill.skill_id,(.current_eval // .eval_id)] | @tsv' \
  "$inventory" | LC_ALL=C sort -u >"$tmp_dir/inventory-current-evals-qualified"
cmp -s "$tmp_dir/current-evals-qualified" "$tmp_dir/inventory-current-evals-qualified" ||
  fail "skill-qualified current evals and typed disposition inventory differ"

for legacy_eval in single-unit-apply-after-mutate rollback-to-last-applied bulk-apply-unapplied-changes; do
  jq -e --arg eval "$legacy_eval" '
    any(.skills[].eval_dispositions[]; .eval_id == $eval and .disposition == "REPLACED_BY" and (.current_eval | length > 0))
  ' "$inventory" >/dev/null || fail "legacy eval alias missing: $legacy_eval"
done

for upstream_release_eval in publish-head-release publish-pinned-to-tag publish-no-assigned-units withdraw-by-id withdraw-blocked-by-gate list-find-by-digest; do
  rg -qx "$upstream_release_eval" "$tmp_dir/current-evals" || fail "upstream release eval disappeared: $upstream_release_eval"
done

if git cat-file -e '855f734^{commit}' 2>/dev/null; then
  : >"$tmp_dir/baseline-evals"
  : >"$tmp_dir/baseline-evals-qualified"
  while IFS= read -r skill; do
    inventory_skill=$skill
    test "$skill" != cub-apply || inventory_skill=release-publish
    git show "855f734:skills/$skill/evals/evals.json" |
      jq -r '(.evals // .prompts)[].name' >>"$tmp_dir/baseline-evals"
    git show "855f734:skills/$skill/evals/evals.json" |
      jq -r --arg skill "$inventory_skill" '(.evals // .prompts)[] | [$skill,.name] | @tsv' >>"$tmp_dir/baseline-evals-qualified"
  done <<<"$baseline_skills"
  sort -u "$tmp_dir/baseline-evals" -o "$tmp_dir/baseline-evals"
  sort -u "$tmp_dir/baseline-evals-qualified" -o "$tmp_dir/baseline-evals-qualified"
  test "$(wc -l <"$tmp_dir/baseline-evals" | tr -d ' ')" = "62" || fail "baseline eval count changed unexpectedly"
  jq -r '.skills[] as $skill | $skill.eval_dispositions[] | [$skill.skill_id,.eval_id] | @tsv' \
    "$inventory" | sort -u >"$tmp_dir/all-inventory-eval-ids-qualified"
  comm -23 "$tmp_dir/baseline-evals-qualified" "$tmp_dir/all-inventory-eval-ids-qualified" >"$tmp_dir/missing-baseline-evals"
  test ! -s "$tmp_dir/missing-baseline-evals" || fail "baseline evals disappeared from typed inventory"
fi

./tools/validate-no-loss-deletions >/dev/null || fail "deleted durable surfaces lack exact typed dispositions"
./tools/validate-no-loss-evals >/dev/null || fail "skill-qualified current/baseline eval dispositions are incomplete"

test ! -e hooks/auto-allow.sh || fail "retired raw Bash auto-allow hook still exists"
bash -n hooks/skill-reminder.sh || fail "routing reminder shell syntax failure"
test -x hooks/skill-reminder.sh || fail "routing reminder is not executable"
jq -e '(.hooks.PreToolUse // []) | length == 0' hooks/hooks.json >/dev/null || fail "Bash PreToolUse permission hook reintroduced"
