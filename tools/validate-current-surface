#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"

release_mode=false
if test "${1:-}" = "--release"; then
  release_mode=true
  shift
fi
test "$#" -eq 0 || {
  printf '%s\n' 'usage: validate-current-surface [--release]' >&2
  exit 2
}

fail() {
  printf 'static compatibility surface: FAIL: %s\n' "$*" >&2
  exit 1
}

for command_name in jq rg git ruby shasum go; do
  command -v "$command_name" >/dev/null 2>&1 || fail "required command missing: $command_name"
done

expected_skills=$(cat <<'EOF'
app-config
confighub-core
cub-mutate
cub-query
import
incident-management
kubernetes-resources
promote-release
release-publish
rollback-revision
skill-examples-bootstrap
target-bind
triggers-and-applygates
verify-apply
worker-bootstrap
EOF
)

baseline_skills=$(cat <<'EOF'
app-config
confighub-core
cub-apply
cub-mutate
cub-query
import
incident-management
kubernetes-resources
promote-release
rollback-revision
skill-examples-bootstrap
target-bind
triggers-and-applygates
verify-apply
worker-bootstrap
EOF
)

actual_skills=$(find skills -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort)
expected_skill_dirs=$(printf '%s\n%s\n' "$expected_skills" cub-apply | sort)
test "$actual_skills" = "$expected_skill_dirs" || fail "skill IDs differ from the 15 canonical skills plus one compatibility stub"

expected_evals=$(printf '%s\n' "$expected_skills" | sed 's|$|/evals/evals.json|')
actual_evals=$(find skills -path '*/evals/evals.json' -type f | sed 's|^skills/||' | sort)
test "$actual_evals" = "$expected_evals" || fail "eval files differ from the stable 15-file surface"

profile=compatibility/current-profile.v1.json
inventory=compatibility/no-loss-inventory.v1.json
read_capabilities=compatibility/read-capability-subsets.v1.json
authority_cases=compatibility/authority-negative-cases.v1.json
profile_cases=compatibility/exact-profile-behavior-cases.v1.json
execution_modes=compatibility/execution-modes.v1.json
semantic_contracts=compatibility/semantic-contracts.v1.json
artifact_manifest=compatibility/release-artifact-manifest.v1.json
render_policy=compatibility/render-source-policy.v1.json
release_review_schema=compatibility/release-review-attestation.schema.json

jq empty .claude-plugin/plugin.json .claude-plugin/marketplace.json hooks/hooks.json \
  .claude/settings.local.json.example "$profile" "$inventory" "$read_capabilities" \
  "$authority_cases" "$profile_cases" "$execution_modes" "$semantic_contracts" \
  "$artifact_manifest" "$render_policy" "$release_review_schema" || fail "invalid JSON"

jq -e '
  . as $profile |
  .schema_version == "confighub-skills-compatibility/v1" and
  .plugin_version == "0.4.1" and
  .candidate_base_commit == "700fcb3" and
  .profile_id == "cub-0.2.15_server-0.2.21_helm-0.1.0" and
  .status == "STANDALONE_SOURCE_CANDIDATE" and
  .authority.standalone_reads == "HOST_PERMISSION" and
  .authority.standalone_mutations == "HOST_PERMISSION_SINGLE_COMMAND" and
  .authority.plugin_autoallow == false and
  .authority.optional_governance_overlay == "ABSENT_BY_DEFAULT" and
  .installed_profile.cub_client.version == "v0.2.15" and
  .installed_profile.cub_client.commit == "3e0cad345fbcc60d4761d928f02fccb8dc5def4f" and
  .installed_profile.cub_client.binary_sha256 == "adc0c6cd53e24d91145eacf40947f929d041613393d4afa36e7d009520133051" and
  .installed_profile.cub_client.build_vcs_modified == true and
  .installed_profile.cub_client.go_module_version == "(devel)" and
  .installed_profile.cub_client.code_signature == "ADHOC_NO_TEAM_IDENTIFIER" and
  .installed_profile.cub_client.package_manager_receipt == "NOT_FOUND" and
  .installed_profile.confighub_server.version == "v0.2.21" and
  .installed_profile.confighub_server.commit == "770cce6816ad8cbc7169272cbf08277eab0f0eb0" and
  .installed_profile.confighub_server.source_checkout_available == false and
  .installed_profile.cub_helm_addon.version == "0.1.0" and
  .installed_profile.cub_helm_addon.commit == "ce1b62faa92ec045d96b0e938bf289f83501fd17" and
  .surface_counts == {skills:15,eval_files:15,eval_cases:75,trigger_families:38,capability_dispositions:68,eval_dispositions:78} and
  .current_delivery_contract.release_provider == "OCI" and
  .current_delivery_contract.release_target_field == "Space.ReleaseTargetID" and
  ([$profile.known_semantic_gaps[].gap_id] | length == (unique | length)) and
  (["release-tag-missing-unit-semantics","mutation-approval-broker","raw-bash-final-argv-policy",
    "native-approval-expected-head-cas","approved-unit-state-cas-integration","release-execution-cas",
    "historical-release-manifest-retention","historical-release-target-attestation",
    "withdrawal-current-membership-gates","release-delete-bypasses-withdrawal-gates",
    "worker-log-evidence-boundary","render-source-execution-boundary","end-to-end-controller-runtime-proof"] |
    all(.[]; . as $gap | any($profile.known_semantic_gaps[]; .gap_id == $gap))) and
  any(.known_semantic_gaps[]; .gap_id == "mutation-approval-broker" and .status == "HISTORICAL_POLICY_RETIRED") and
  any(.known_semantic_gaps[]; .gap_id == "raw-bash-final-argv-policy" and .status == "AUTOALLOW_DISABLED_STANDALONE_USABLE")
' "$profile" >/dev/null || fail "current compatibility profile changed or overclaims evidence"

jq -e '
  .schema_version == "confighub-skills-read-capabilities/v1" and
  .candidate_plugin_version == "0.4.1" and
  .status == "STANDALONE_HOST_PERMISSION" and
  .raw_bash_autoallow == false and
  .enforcement.current == "NO_PLUGIN_OR_SKILL_BASH_AUTOALLOW" and
  .enforcement.read_execution == "HOST_PERMISSION" and
  .enforcement.mutation_execution == "HOST_PERMISSION_SINGLE_COMMAND" and
  .enforcement.optional_governance_overlay == "ABSENT_BY_DEFAULT" and
  (.skills | length) == 15 and
  ([.skills[].skill_id] | length == (unique | length)) and
  all(.skills[]; (.capabilities | type == "array" and length > 0)) and
  (.denied_from_any_future_autoallow | index("mutation-autoallow")) != null and
  (.denied_from_any_future_autoallow | index("shell-composition-or-expansion")) != null
' "$read_capabilities" >/dev/null || fail "per-skill read capability boundary changed"

jq -e '
  .schema_version == "confighub-skills-render-source-policy/v1" and
  .source_preflight.duplicate_yaml_keys == "DENY" and
  .source_preflight.remote_url_or_repository == "DENY" and
  .source_preflight.unpinned_source_or_dependency == "DENY" and
  .source_preflight.plugin_or_exec_generator == "DENY" and
  .source_preflight.helm_tpl_dynamic_evaluation == "DENY" and
  .source_preflight.helm_dependency_archives == "DENY_REQUIRE_UNPACKED_VENDORED_DIRECTORY" and
  (.source_preflight.kustomize_schema_authority | contains("api@v0.21.1")) and
  .future_wrapper_requirements.network == "OFF" and
  .future_wrapper_requirements.renderer_binary_digest_required == true and
  .future_wrapper_requirements.max_source_bytes > 0 and
  .future_wrapper_requirements.max_rendered_bytes > 0 and
  .future_wrapper_requirements.max_resources > 0 and
  .future_wrapper_requirements.receipt_required == true
' "$render_policy" >/dev/null || fail "render source policy lost its bounded-source requirements"

jq -e '
  .schema_version == "confighub-skills-authority-negative-cases/v1" and
  .candidate_plugin_version == "0.4.1" and
  .current_boundary == "NO_PLUGIN_AUTOALLOW_HOST_PERMISSION_DECIDES" and
  (.cases | length) == 12 and
  ([.cases[].case_id] | length == (unique | length)) and
  all(.cases[]; .current_outcome == "NOT_AUTOALLOWED" or .current_outcome == "HOST_ASK") and
  any(.cases[]; .case_id == "quoted-where-comparison" and .current_outcome == "HOST_ASK")
' "$authority_cases" >/dev/null || fail "automatic-permission negative case matrix is incomplete"

jq -e '
  .candidate_plugin_version == "0.4.1" and
  .status == "HISTORICAL_SOURCE_REVIEW_FIXTURE" and
  (.scope | contains("not current")) and
  .profile_id == "cub-0.2.11_server-0.2.15_helm-0.1.0" and
  .reviewed_client_commit == "683dce12c2f26ad151aa9e5763e60b0ac66172a4" and
  .reviewed_server_commit == "eebd77551316efc8c58028f6d4275ab504e17ce7" and
  (.cases | length) == 17 and
  ([.cases[].case_id] | length == (unique | length)) and
  any(.cases[]; .case_id == "worker-run-positional-slug" and .expected == "REQUIRE_EXACTLY_ONE_WORKER_SLUG") and
  any(.cases[]; .case_id == "worker-run-auto-creates-missing-worker" and .expected == "CLASSIFY_WORKER_RUN_AS_MUTATING")
' "$profile_cases" >/dev/null || fail "historical exact-profile fixture is incomplete or presented as current"

jq -e '.version == "0.4.1" and (.description | contains("Standalone") and contains("host permission") and contains("no automatic tool permission"))' \
  .claude-plugin/plugin.json >/dev/null || fail "plugin metadata does not describe the 0.4.1 standalone contract"
jq -e '.metadata.description | contains("Standalone") and contains("host permission") and contains("no tool is preapproved")' \
  .claude-plugin/marketplace.json >/dev/null || fail "marketplace metadata does not describe the standalone contract"
jq -e '.permissions.allow == [] and (. ["//"] | contains("grants no Bash auto-allow"))' \
  .claude/settings.local.json.example >/dev/null || fail "settings example grants or implies plugin autoallow"

jq -e '
  .candidate_plugin_version == "0.4.1" and
  .candidate_base_commit == "de74ac357b88e4a39b22b2afb6a6ff232d91ded5" and
  .compatibility_profile == "compatibility/current-profile.v1.json" and
  any(.global_claim_limits[]; .block_id == "approved-unit-state-cas-integration" and .status == "CLAIM_LIMIT" and .result == "PREVIEW_TO_EXECUTION_ATOMICITY_NOT_PROVEN") and
  any(.retired_skill_dispositions[]; .skill_id == "cub-apply" and .disposition == "REPLACED_BY" and .replacement == "release-publish") and
  any(.compatibility_aliases[]; .alias == "/confighub-skills:cub-apply" and .observable_path == "commands/cub-apply.md") and
  any(.compatibility_aliases[]; .alias == "cub-apply" and .observable_path == "skills/cub-apply/SKILL.md")
' "$inventory" >/dev/null || fail "no-loss inventory/version/profile binding is incomplete"

git merge-base --is-ancestor 700fcb3d2c2dd92ee656de2ed7c7a7397be90690 HEAD || fail "candidate branch is not based on main 700fcb3"

inventory_skills=$(jq -r '.skills[].skill_id' "$inventory" | sort)
test "$inventory_skills" = "$expected_skills" || fail "typed inventory does not cover exactly the stable skill IDs"
jq -e '
  (.skills | length) == 15 and
  ([.skills[].trigger_dispositions[]] | length) == 38 and
  ([.skills[].capability_dispositions[]] | length) == 68 and
  ([.skills[].eval_dispositions[]] | length) == 78 and
  (.disposition_enum | index("STANDALONE_HOST_PERMISSION")) != null and
  (.disposition_enum | index("COACHED_TERMINAL_EXECUTION")) != null and
  (.disposition_enum | index("BLOCKED_PENDING_BROKER")) == null and
  (.disposition_enum as $allowed |
    ([.global_legacy_jobs[].disposition,.deleted_surface_dispositions[].disposition,
      .retired_skill_dispositions[].disposition,.compatibility_aliases[].disposition,
      .upstream_change_dispositions[].disposition,.skills[].skill_disposition,
      .skills[].trigger_dispositions[].disposition,.skills[].capability_dispositions[].disposition,
      .skills[].eval_dispositions[].disposition] as $values |
      all($values[]; . as $d | ($allowed | index($d)) != null))) and
  ([.. | objects | select(.disposition? == "REPLACED_BY")] |
    all(.[]; (((.replacement? // .current_eval? // "") | type) == "string") and ((.replacement? // .current_eval? // "") | length) > 0))
' "$inventory" >/dev/null || fail "typed no-loss dispositions are incomplete"

test -f commands/cub-apply.md || fail "cub-apply compatibility command disappeared"
command_frontmatter=$(./tools/parse-frontmatter commands/cub-apply.md) || fail "cub-apply command frontmatter invalid"
printf '%s' "$command_frontmatter" | jq -e '.["allowed-tools"] == []' >/dev/null || fail "cub-apply command grants tools"
stub_frontmatter=$(./tools/parse-frontmatter skills/cub-apply/SKILL.md) || fail "cub-apply Skill frontmatter invalid"
printf '%s' "$stub_frontmatter" | jq -e '.name == "cub-apply" and .["allowed-tools"] == [] and .["read-capability-subset"] == "none" and .["compatibility-stub"] == true' >/dev/null || fail "cub-apply Skill is not the stable no-tools identity"
rg -q 'release-publish' commands/cub-apply.md skills/cub-apply/SKILL.md || fail "cub-apply compatibility paths do not route to release-publish"

tmp_dir=$(mktemp -d)
trap 'rm -rf "$tmp_dir"' EXIT
: >"$tmp_dir/current-evals"
: >"$tmp_dir/current-evals-qualified"
while IFS= read -r skill; do
  skill_file="skills/$skill/SKILL.md"
  eval_file="skills/$skill/evals/evals.json"
  frontmatter=$(./tools/parse-frontmatter "$skill_file") || fail "full YAML frontmatter parse failed for $skill"
  printf '%s' "$frontmatter" | jq -e --arg skill "$skill" '
    .name == $skill and (.description | type == "string" and length > 0) and
    (.phase | type == "string" and length > 0) and .["allowed-tools"] == [] and
    .["read-capability-subset"] == $skill and (has("compatibility-stub") | not)
  ' >/dev/null || fail "frontmatter policy mismatch for $skill"
  rg -q 'references/execution-modes\.md' "$skill_file" || fail "$skill does not inherit execution modes"
  jq -e --arg skill "$skill" 'any(.skills[]; .skill_id == $skill and (.capabilities | length > 0))' \
    "$read_capabilities" >/dev/null || fail "read subset missing for $skill"
  jq -e '
    .execution_policy == "STANDALONE_HOST_ASK_WITH_OPTIONAL_OVERLAY" and
    ((.evals // .prompts) | type == "array" and length > 0) and
    all((.evals // .prompts)[]; (.name|length)>0 and (.prompt|length)>0 and (.expected_output|length)>0) and
    ([((.evals // .prompts)[].name)] | length == (unique | length))
  ' "$eval_file" >/dev/null || fail "eval policy/schema/expectation failure in $skill"
  jq -r '(.evals // .prompts)[].name' "$eval_file" >>"$tmp_dir/current-evals"
  jq -r --arg skill "$skill" '(.evals // .prompts)[] | [$skill,.name] | @tsv' "$eval_file" >>"$tmp_dir/current-evals-qualified"
done <<<"$expected_skills"

LC_ALL=C sort -u "$tmp_dir/current-evals" -o "$tmp_dir/current-evals"
LC_ALL=C sort -u "$tmp_dir/current-evals-qualified" -o "$tmp_dir/current-evals-qualified"
test "$(wc -l <"$tmp_dir/current-evals" | tr -d ' ')" = 75 || fail "current eval-case count is not 75"
jq -r '.skills[] as $skill | $skill.eval_dispositions[] | [$skill.skill_id,(.current_eval // .eval_id)] | @tsv' \
  "$inventory" | LC_ALL=C sort -u >"$tmp_dir/inventory-current-evals-qualified"
cmp -s "$tmp_dir/current-evals-qualified" "$tmp_dir/inventory-current-evals-qualified" || fail "current evals and typed inventory differ by Skill"

for legacy_eval in single-unit-apply-after-mutate rollback-to-last-applied bulk-apply-unapplied-changes; do
  jq -e --arg eval "$legacy_eval" 'any(.skills[].eval_dispositions[]; .eval_id == $eval and .disposition == "REPLACED_BY" and (.current_eval|length)>0)' \
    "$inventory" >/dev/null || fail "legacy eval mapping missing: $legacy_eval"
done
for release_eval in publish-head-release publish-pinned-to-tag publish-no-assigned-units withdraw-by-id withdraw-blocked-by-gate list-find-by-digest; do
  rg -qx "$release_eval" "$tmp_dir/current-evals" || fail "release eval disappeared: $release_eval"
done

./tools/validate-no-loss-deletions >/dev/null || fail "deleted durable surfaces lack exact dispositions"
./tools/validate-no-loss-evals >/dev/null || fail "current/baseline eval dispositions are incomplete"

test ! -e hooks/auto-allow.sh || fail "retired raw Bash auto-allow hook still exists"
bash -n hooks/skill-reminder.sh || fail "routing reminder shell syntax failure"
test -x hooks/skill-reminder.sh || fail "routing reminder is not executable"
jq -e '(.hooks.PreToolUse // []) | length == 0' hooks/hooks.json >/dev/null || fail "PreToolUse permission hook reintroduced"
if rg -n "permissionDecision['\"[:space:]:]+allow|Bash\\(" hooks .claude/settings.local.json.example skills/*/SKILL.md; then
  fail "plugin-provided Bash allow reintroduced"
fi
rg -q '^## Install or update$' README.md || fail "normal installation/update guidance disappeared"
rg -q 'allowed-tools: \[\].*zero preapprovals' README.md || fail "allowed-tools standalone meaning is not explained"

# Product no-loss and safety invariants. These are plain semantic checks, not
# local hash checks, so a self-renewed fingerprint cannot erase them.
rg -q 'Space\.ReleaseTargetID' skills/target-bind/SKILL.md || fail "target binding omits Space.ReleaseTargetID"
rg -q 'cub space update <app-space> --release-target <target-space>/<target-slug>' skills/target-bind/SKILL.md || fail "target-binding command disappeared"
rg -q 'EffectiveReleaseSet' skills/target-bind/SKILL.md skills/release-publish/SKILL.md || fail "effective Release membership disappeared"
rg -q 'Unit\.TargetID == Space\.ReleaseTargetID' skills/release-publish/SKILL.md || fail "Release membership equality disappeared"
rg -q 'RevisionID' skills/release-publish/SKILL.md && rg -q 'DataHash' skills/release-publish/SKILL.md || fail "Release preview omits revision identities/hashes"
rg -q 'Never convert a narrow request into a broader publish silently' skills/release-publish/SKILL.md || fail "scope-expansion guard disappeared"
rg -q 'preview is not atomically bound to execution' skills/release-publish/SKILL.md || fail "publication pre-read race disclosure disappeared"
rg -q 'Installed v0\.2\.15 help advertises' skills/release-publish/SKILL.md skills/triggers-and-applygates/SKILL.md || fail "current native-approval help boundary disappeared"
rg -q 'Host permission likewise does not satisfy `vet-approvedby`' skills/triggers-and-applygates/SKILL.md || fail "native approval and host permission are conflated"
rg -q 'cub release withdraw --help' skills/release-publish/SKILL.md skills/release-publish/evals/evals.json || fail "withdrawal help check disappeared"
rg -q 'cub release delete --help' skills/release-publish/SKILL.md skills/release-publish/evals/evals.json || fail "deletion help check disappeared"
rg -q 'Published=false' skills/release-publish/SKILL.md || fail "withdrawal retained-record behavior disappeared"
rg -q 'not-found/blob-unavailable' skills/release-publish/SKILL.md || fail "deletion retention postcondition disappeared"
rg -q 'public Release resource has no `TargetID`' skills/release-publish/SKILL.md || fail "historical Target claim boundary disappeared"
rg -q 'com\.confighub\.target\.id' README.md skills/release-publish/SKILL.md skills/verify-apply/SKILL.md || fail "digest-attested Target evidence disappeared"
rg -q 'Revision\.Releases' skills/release-publish/SKILL.md skills/verify-apply/SKILL.md references/revisions.md || fail "historical membership linkage disappeared"
rg -q 'same-count member swap' skills/verify-apply/SKILL.md || fail "historical same-count swap caveat disappeared"
rg -q 'historical Release manifest is unproven' skills/verify-apply/SKILL.md || fail "historical manifest proof gap disappeared"
rg -q -- '-o jq=.UnitStatus' skills/verify-apply/SKILL.md && rg -q -- '-o jq=.LatestUnitEvent' skills/verify-apply/SKILL.md && rg -q 'cub unit-event list <unit>' skills/verify-apply/SKILL.md || fail "historical Unit-event diagnostics disappeared"
jq -e 'any(.global_legacy_jobs[]; .capability_id == "bridge-or-unit-runtime-delivery" and .disposition == "VERSIONED_LEGACY")' "$inventory" >/dev/null || fail "retired delivery history disappeared"
jq -e 'any(.skills[] | select(.skill_id == "release-publish").trigger_dispositions[]; .trigger_id == "cancel-inflight-unit-apply" and .disposition == "VERSIONED_LEGACY")' "$inventory" >/dev/null || fail "historical cancellation job disappeared"

rg -q 'cub helm install <release-name> <chart-ref>' skills/import/SKILL.md || fail "Helm install shape disappeared"
rg -q '<component>-helm' skills/import/SKILL.md && rg -q '<component>-base' skills/import/SKILL.md || fail "Helm source/base topology disappeared"
rg -q 'one Unit per chart template file' skills/import/SKILL.md || fail "Helm Unit granularity disappeared"
rg -q 'Never emit a raw `kustomize build \| cub variant upload` pipeline' skills/import/SKILL.md || fail "unsafe Kustomize pipeline refusal disappeared"
rg -q 'separate-per-environment compatibility lane' skills/import/SKILL.md || fail "Helm-values compatibility lane disappeared"
rg -Fq -- "--space-pattern 'template:{{.Labels.Component}}'" skills/import/SKILL.md || fail "Helm-values naming guard disappeared"

rg -q 'retired-unit-runtime-verbs' skills/rollback-revision/SKILL.md "$inventory" || fail "retired replay anti-pattern disappeared"
rg -q 'it is \*\*not rollback\*\*' skills/rollback-revision/SKILL.md || fail "head-moving rollback distinction disappeared"
rg -q 'not proof of controller consumption or current runtime state' skills/rollback-revision/SKILL.md || fail "rollback live-state claim boundary disappeared"
rg -q 'currently-running claim requires controller and Kubernetes evidence' skills/cub-query/SKILL.md || fail "query/runtime proof boundary disappeared"
rg -q '^Incident: INC-512 rollback checkout to prior image$' skills/incident-management/SKILL.md || fail "safe incident provenance example disappeared"
rg -q 'Shared Units must be sequenced or' skills/incident-management/SKILL.md || fail "concurrent-incident Unit guard disappeared"
rg -q 'incident-<YYYYMMDD>-<ticket>' skills/incident-management/SKILL.md || fail "incident resolution marker disappeared"

rg -q 'cub worker run --space <space> <worker-slug> --functions' skills/worker-bootstrap/SKILL.md || fail "worker positional slug disappeared"
rg -q 'cobra\.ExactArgs\(1\)' skills/worker-bootstrap/SKILL.md skills/worker-bootstrap/evals/evals.json || fail "worker help/source discrepancy disappeared"
rg -q 'attempts to create' skills/worker-bootstrap/SKILL.md || fail "worker-run implicit create side effect disappeared"
! rg -q '^[[:space:]]*cub worker logs([[:space:]]|$)' skills/worker-bootstrap/SKILL.md || fail "unbounded worker log command re-entered active guidance"
! rg -q '^[[:space:]]*kubectl logs([[:space:]]|$)' skills/worker-bootstrap/SKILL.md || fail "unbounded Kubernetes log command re-entered active guidance"
rg -q 'scans the full' skills/worker-bootstrap/SKILL.md || fail "worker full-file log caveat disappeared"
jq -e '
  any(.skills[] | select(.skill_id == "worker-bootstrap").capability_dispositions[]; .capability_id == "server-worker-proposal" and .disposition == "STANDALONE_HOST_PERMISSION") and
  any(.skills[] | select(.skill_id == "worker-bootstrap").capability_dispositions[]; .capability_id == "external-worker-proposal" and .disposition == "COACHED_TERMINAL_EXECUTION") and
  any(.skills[] | select(.skill_id == "worker-bootstrap").capability_dispositions[]; .capability_id == "worker-log-diagnosis" and .disposition == "BLOCKED_PENDING_EVIDENCE_PROXY")
' "$inventory" >/dev/null || fail "worker execution/evidence dispositions regressed"

if rg -n \
  -e '^[[:space:]]*cub[[:space:]]+unit[[:space:]]+(apply|refresh|destroy|gitops)([[:space:]]|$)' \
  -e '^[[:space:]]*cub[[:space:]]+helm[[:space:]]+install[^\n]*--space' \
  -e '^[[:space:]]*cub[[:space:]]+helm[[:space:]]+upgrade[^\n]*--update-crds' \
  -e 'ReleaseURL' -e '--web([[:space:]]|$)' \
  README.md SKILL_TEMPLATE.md references skills hooks; then
  fail "retired command or flag appears as an active command surface"
fi

if command -v cub >/dev/null 2>&1; then
  cub_version=$(cub version)
  printf '%s\n' "$cub_version" | rg -q 'Client Version:|Client' || fail "cub version output lacks client identity"
  printf '%s\n' "$cub_version" | rg -q 'Version:[[:space:]]+v0\.2\.15' || fail "installed cub client version differs from profile"
