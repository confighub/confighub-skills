#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)

# Hard-coded behavioral policy checks. This test is intentionally independent
# of the generated fingerprint and artifact manifests it is policing.
"$root/tools/test-release-artifact-gate" >/dev/null

test -f "$root/skills/cub-apply/SKILL.md"
frontmatter=$("$root/tools/parse-frontmatter" "$root/skills/cub-apply/SKILL.md")
printf '%s' "$frontmatter" | jq -e '.name == "cub-apply" and .["allowed-tools"] == [] and .["compatibility-stub"] == true' >/dev/null
for skill in cub-mutate rollback-revision promote-release; do
  rg -q 'pre-read|Pre-read|not atomic|not prove atomic|not atomically' "$root/skills/$skill/SKILL.md"
done
! rg -q '^[[:space:]]*cub worker logs([[:space:]]|$)' "$root/skills/worker-bootstrap/SKILL.md"
rg -q 'scans the full' "$root/skills/worker-bootstrap/SKILL.md"
rg -q 'network-off, byte/resource-capped wrapper' "$root/skills/import/SKILL.md"
"$root/tools/test-execution-modes" >/dev/null

printf '%s\n' 'independent permission/safety policy tests: PASS (non-generated policy assertions + adversarial subprocess suites)'
